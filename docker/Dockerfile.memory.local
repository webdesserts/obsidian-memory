# syntax=docker/dockerfile:1
#
# LOCAL-ONLY build for memory — NOT the canonical release pipeline.
# docker/Dockerfile.memory downloads a pre-built cargo-dist release artifact
# published by .github/workflows/docker.yml (triggered by a real semver git
# tag). This Dockerfile compiles memory from the local working tree instead,
# for staging a code change ahead of a real release. Do not wire this into
# CI or the ghcr.io publish pipeline.

FROM rust:bookworm AS builder

WORKDIR /build

# memory has path dependencies on other workspace crates (wiki-links,
# obsidian-fs, notes-core, etc.), so `cargo build -p memory` needs the whole
# workspace to resolve. See .dockerignore for exclusions (target/, .git/).
COPY . .

# -j2: the build VM's memory budget can't sustain default (CPU-count) rustc
# parallelism against this workspace's heavier deps (loro-internal OOM-killed
# at unbounded parallelism during staging).
RUN cargo build --release -p memory -j 2

# --- Runtime layer, mirrored from docker/Dockerfile.memory (the canonical image) ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/memory /usr/local/bin/memory

# Create non-root user (UID 1000 for consistency with the canonical image)
RUN useradd -m -u 1000 memory

# Create vault and config mount points
RUN mkdir -p /notes /config && chown memory:memory /notes /config

USER memory
WORKDIR /notes

EXPOSE 3000

# Health check — identical to the canonical image
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:3000/health || exit 1

ENTRYPOINT ["memory"]
CMD ["up", "--vault", "/notes", "--listen", "0.0.0.0:3000"]
