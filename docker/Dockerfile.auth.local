# syntax=docker/dockerfile:1
#
# LOCAL-ONLY build for auth-service — NOT the canonical release pipeline.
# docker/Dockerfile.auth downloads a pre-built cargo-dist release artifact
# published by .github/workflows/docker.yml (triggered by a real semver git
# tag). This Dockerfile compiles auth-service from the local working tree
# instead, for staging a code change ahead of a real release. Do not wire
# this into CI or the ghcr.io publish pipeline.

FROM rust:bookworm AS builder

WORKDIR /build

# auth-service has no path dependencies on other workspace crates, but
# `cargo build -p auth-service` still needs the whole workspace to resolve
# (every member listed in the root Cargo.toml must have a valid Cargo.toml
# on disk). See .dockerignore for exclusions (target/, .git/, node_modules/).
COPY . .

RUN cargo build --release -p auth-service

# --- Runtime layer, mirrored from docker/Dockerfile.auth (the canonical image) ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/auth-service /usr/local/bin/auth-service

# Create non-root user (UID 1000 for consistency with the canonical image)
RUN useradd -m -u 1000 auth

# Create config mount point
RUN mkdir -p /config && chown auth:auth /config

USER auth
WORKDIR /config

EXPOSE 3001

# Health check — identical to the canonical image
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -sf http://localhost:3001/.well-known/oauth-authorization-server > /dev/null || exit 1

ENTRYPOINT ["auth-service"]
CMD ["--port", "3001", "--bind", "0.0.0.0", "--config-path", "/config"]
