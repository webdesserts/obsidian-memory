# Scratch Caddyfile for autonomy/t:228's isolated live-wire verification
# stack (deploy/t228/verify/). NOT a copy of the live production
# /opt/docker/caddy/Caddyfile — this proves the copy_headers syntax and
# runtime behavior in isolation, on a scratch network, against a
# header-reflecting upstream instead of the real memory/primed services.
#
# Shape mirrors the live file's four forward_auth blocks (upstream
# verified 2026-09-02): /mcp* and /llm/* copy Authorization only today;
# /design/* and the catch-all copy X-Auth-User only today. Each gains
# X-Auth-Actor here, which is what Commit 3's Caddyfile.staged also does
# to the real file. Upstreams are repointed at the echo service
# (mccutchen/go-httpbin's /headers endpoint reflects request headers as
# JSON) since this stack's job is proving the Caddy-forwarding half of
# additive-uuid-header, not exercising memory/primed themselves.
#
# Deliberately DROPPED here: the live /design/* and catch-all blocks'
# `@denied`/`handle_response` override, which turns forward_auth's 401
# into a 302 redirect to /auth/login for browser UX. That's a live-site
# UX concern this proof doesn't need -- verify.sh's unauthenticated-
# request assertion checks for a plain 401 (per the plan's own check 4),
# which is what forward_auth returns natively without the override.

:80 {
	handle /mcp* {
		forward_auth auth-service:3001 {
			uri /validate
			copy_headers Authorization X-Auth-Actor
		}
		reverse_proxy echo:8080
	}

	handle /llm/* {
		forward_auth auth-service:3001 {
			uri /validate
			copy_headers Authorization X-Auth-Actor
		}
		reverse_proxy echo:8080
	}

	handle_path /design/* {
		forward_auth auth-service:3001 {
			uri /validate
			copy_headers X-Auth-User X-Auth-Actor
		}
		reverse_proxy echo:8080
	}

	# Catch-all — mirrors the live file's final `handle {}` block.
	handle {
		forward_auth auth-service:3001 {
			uri /validate
			copy_headers X-Auth-User X-Auth-Actor
		}
		reverse_proxy echo:8080
	}

	log {
		output stdout
		format json
	}
}
