# Live Caddyfile. Last change: autonomy/t:228, 2026-09-02. Rollback: deploy/t228/ROLLBACK.md
#
# Written by worker-t228, obsidian-memory branch t228 (commits d264c2d,
# b74b714) per autonomy/t:228; the Worker builds and stages only, the
# orchestrator performs every live mutation.
#
# WHAT THIS DOES: adds X-Auth-Actor to the copy_headers list on all four
# forward_auth blocks (/mcp*, /llm/*, /design/*, catch-all). X-Auth-User
# behavior is unchanged on all four -- this is purely additive. The
# auth-service code change (branch t228, crates/auth-service/src/validation.rs)
# emits X-Auth-Actor conditionally: only when the winning credential
# carries a known actor uuid (today: session-cookie logins, via
# StoredUser.id; API keys have none until autonomy/t:227), never with an
# empty/placeholder value. Verified 2026-09-02: neither the memory crate
# nor llama-swap reads any X-Auth header today, so this edit alone is
# inert on /mcp* and /llm* until a consumer is built. This Caddyfile edit
# alone does nothing until the auth-service image running in production
# actually emits the header -- see deploy/t228/DEPLOY.md for the required
# accompanying auth-service deploy step.
#
# TO ACTIVATE (orchestrator-executed; run from /opt/docker/caddy):
#   md5 -q Caddyfile   # record before-state
#   cp Caddyfile Caddyfile.bak-2026-09-02-t228-caddy
#   cp <worktree>/deploy/t228/Caddyfile.staged Caddyfile
#   docker restart caddy-caddy-1   # prefer over `caddy reload` per Device.md's bind-mount footgun
#   md5 -q Caddyfile   # must equal:
#   docker exec caddy-caddy-1 md5sum /etc/caddy/Caddyfile   # (virtiofs stale-view check)
#
# ROLLBACK: restore the dated backup and restart. Full recipe in
# deploy/t228/ROLLBACK.md.
# No volumes are touched by either path.

# Obsidian Memory LAN Stack

http://umbra.computer {
    redir https://{host}{uri} permanent
}

umbra.computer {
    # Setup endpoint for first-time passkey registration (public but rate-limited)
    handle /auth/setup* {
        uri strip_prefix /auth
        reverse_proxy auth-service:3001 {
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Login endpoint for passkey authentication
    handle /auth/login* {
        uri strip_prefix /auth
        reverse_proxy auth-service:3001 {
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Logout endpoint
    handle /auth/logout {
        uri strip_prefix /auth
        reverse_proxy auth-service:3001 {
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Protected MCP endpoint - requires a valid API key
    handle /mcp* {
        forward_auth auth-service:3001 {
            uri /validate
            copy_headers Authorization X-Auth-Actor
        }
        reverse_proxy memory:3000 {
            # Critical: disable buffering for SSE streaming
            flush_interval -1
            header_up X-Forwarded-Proto {scheme}
            # Extended timeouts for long-running MCP operations (embedding computation)
            transport http {
                read_timeout 5m
                write_timeout 5m
            }
        }
    }

    # WebSocket for P2P sync (sync-daemon handles its own auth)
    handle /sync {
        reverse_proxy sync:8080 {
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # LLM proxy to llama-server on the host (auth-protected)
    handle /llm/* {
        forward_auth auth-service:3001 {
            uri /validate
            copy_headers Authorization X-Auth-Actor
        }
        uri strip_prefix /llm
        reverse_proxy host.docker.internal:8081
    }

    # LiveKit WebSocket signaling
    handle /livekit* {
        uri strip_prefix /livekit
        reverse_proxy host.docker.internal:7880
    }

    # Voice chat app
    handle /voice* {
        reverse_proxy voice-chat:3000
    }

    # iroh relay — memory-desktop app's embedded relay on the HOST (not in docker).
    # iroh clients hard-set the /relay path, so the public relay URL is just
    # https://umbra.computer/ (443 implied); Caddy upgrades the WebSocket natively.
    handle /relay* {
        reverse_proxy host.docker.internal:3340
    }

    # iroh net_report latency probes (GET /generate_204) — same upstream as /relay;
    # without this they 404 at the catch-all and spam WARNs on every peer's report.
    handle /generate_204 {
        reverse_proxy host.docker.internal:3340
    }

    # iroh net_report HTTPS latency probe (GET /ping) — also relay upstream. A 404
    # here silently blocks home-relay selection on every client of this relay
    # (bit us 2026-06-12: app instances never logged "home is now relay").
    handle /ping {
        reverse_proxy host.docker.internal:3340
    }

    # @webdesserts/ui design-system site (static build, deployed by the ui lane).
    # Same auth gate as the board — review from any logged-in device.
    redir /design /design/ 301
    handle_path /design/* {
        forward_auth auth-service:3001 {
            uri /validate
            copy_headers X-Auth-User X-Auth-Actor
            @denied status 401 403
            handle_response @denied {
                redir * /auth/login 302
            }
        }
        root * /srv/design
        try_files {path} /index.html
        file_server
    }

    # Prime agent chat UI + API
    handle {
        forward_auth auth-service:3001 {
            uri /validate
            copy_headers X-Auth-User X-Auth-Actor
            @denied status 401 403
            handle_response @denied {
                redir * /auth/login 302
            }
        }
        reverse_proxy host.docker.internal:4600 {
            header_up X-Forwarded-Proto {scheme}
        }
    }

    log {
        output stdout
        format json
    }
}
