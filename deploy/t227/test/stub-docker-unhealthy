#!/bin/sh
# Stub `docker` for deploy/t227/test's bounded-restart exercise
# (see README.md in this directory).
#
# Simulates a wedged auth-service: `docker info` always succeeds (so the
# watchdog takes the "container down", not "daemon unreachable", branch)
# and `docker inspect ... Health.Status` always reports "unhealthy".
# `compose`/`exec` subcommands are answered but never exercised by the
# bounded-restart test itself, since it runs the watchdog with DRY_RUN=1
# (the watchdog logs "would restart" without ever invoking `docker
# compose`, and an already-"unhealthy" inspect result never falls
# through to the in-network `exec ... curl /validate` probe).
case "$1" in
  info)
    exit 0
    ;;
  inspect)
    echo "unhealthy"
    exit 0
    ;;
  compose)
    echo "STUB: docker compose $*" >&2
    exit 0
    ;;
  exec)
    # Would be the in-network /validate probe fallback -- not reached in
    # this test (see header), stubbed for completeness / defensiveness.
    echo "000"
    exit 0
    ;;
  *)
    echo "STUB docker: unhandled subcommand: $*" >&2
    exit 1
    ;;
esac
