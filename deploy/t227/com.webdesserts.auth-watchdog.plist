<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.webdesserts.auth-watchdog</string>

	<!-- autonomy/t:227 (break-glass-independent). Polls the obsidian-memory
	     auth-service container's health every StartInterval seconds and
	     restarts it (bounded -- see auth-watchdog.sh's own header comment)
	     when it's down. Installed FOR user nir (this device's account,
	     not "michael" -- see ~/Device.md), runs as that user; the script
	     it invokes never requires elevated privileges (docker/colima are
	     both already usable by nir per Device.md's Docker-via-Colima
	     section). -->

	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/opt/docker/obsidian-memory/auth-watchdog.sh</string>
	</array>

	<!-- Poll every 60s. StartInterval (not a KeepAlive daemon) -- each
	     invocation is a single evaluate-and-act cycle that exits;
	     launchd relaunches it on the next tick. This is what makes the
	     bounded-restart window in auth-watchdog.sh's own STATE_FILE
	     meaningful: the script has no long-lived process state between
	     invocations, only the timestamps it persists to disk. -->
	<key>StartInterval</key>
	<integer>60</integer>

	<!-- Also run once immediately at load (agent install / login / a
	     `launchctl bootstrap`), rather than waiting a full 60s for the
	     first health read. -->
	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/nir/Library/Logs/webdesserts-auth-watchdog/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/nir/Library/Logs/webdesserts-auth-watchdog/launchd-stderr.log</string>

	<!-- launchd's own minimal PATH omits Homebrew's prefix -- defensive
	     only: auth-watchdog.sh already resolves DOCKER/COLIMA/CURL as
	     full absolute paths itself (Device.md: "full paths for Homebrew
	     binaries"), so this isn't load-bearing for those three, but the
	     script also shells out to plain `date`/`awk`/`sed`/`mkdir`/`wc`/
	     `hostname`/`mv`/`tr`/`cat`, all standard under /usr/bin or /bin
	     on macOS and already covered by launchd's own default PATH --
	     set explicitly anyway so the agent's environment doesn't depend
	     on launchd's undocumented default. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
